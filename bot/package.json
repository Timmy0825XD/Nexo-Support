{
  "name": "nexo-support-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "DISCORD_SKIP_COMMAND_SYNC=1 node --watch --import tsx src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "commands:sync": "node --import tsx src/scripts/sync-commands.ts",
    "commands:clear": "node --import tsx src/scripts/sync-commands.ts --clear",
    "db:migrate": "prisma migrate deploy --schema ../prisma/schema.prisma",
    "db:push": "prisma db push --schema ../prisma/schema.prisma --skip-generate",
    "db:generate": "prisma generate --schema ../prisma/schema.prisma"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.49.8",
    "discord-html-transcripts": "^3.3.0",
    "discord.js": "^14.21.0",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "prisma": "^6.9.0",
    "typescript": "^5.8.3"
  }
}
