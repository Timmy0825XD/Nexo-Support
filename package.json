{
  "name": "nexo-support",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "workspaces": [
    "bot"
  ],
  "scripts": {
    "start": "node index.js",
    "dev": "npm run dev --workspace=nexo-support-bot",
    "build": "npm run build --workspace=nexo-support-bot",
    "lint": "npm run lint --workspace=nexo-support-bot",
    "db:push": "npm run db:push --workspace=nexo-support-bot",
    "db:migrate": "npm run db:migrate --workspace=nexo-support-bot",
    "db:generate": "npm run db:generate --workspace=nexo-support-bot",
    "commands:sync": "npm run commands:sync --workspace=nexo-support-bot",
    "commands:clear": "npm run commands:clear --workspace=nexo-support-bot"
  },
  "engines": {
    "node": ">=20"
  }
}
